# ================================================================
# Trigger.dev v4 环境变量配置
# 部署前请修改所有标注「必须修改」的项目
# 生成随机密钥命令：openssl rand -hex 32
# ================================================================

# ----------------------------------------------------------------
# 版本锁定（推荐，避免自动升级出问题）
# ----------------------------------------------------------------
TRIGGER_IMAGE_TAG=v4.4.4

# ----------------------------------------------------------------
# 访问地址（必须修改）
# 如果有域名：https://trigger.yourdomain.com
# 如果用 IP：http://你的服务器IP:8030
# ----------------------------------------------------------------
APP_ORIGIN=http://你的服务器IP:8030

# ----------------------------------------------------------------
# 安全密钥（必须修改，三个值均需不同）
# 生成方式：openssl rand -hex 32
# ----------------------------------------------------------------
SESSION_SECRET=替换为随机字符串_openssl_rand_hex_32
MAGIC_LINK_SECRET=替换为随机字符串_openssl_rand_hex_32
ENCRYPTION_KEY=替换为随机字符串_openssl_rand_hex_32

# ----------------------------------------------------------------
# 数据库密码（必须修改）
# ----------------------------------------------------------------
POSTGRES_PASSWORD=替换为强密码

# ----------------------------------------------------------------
# 内置镜像仓库（必须修改密码）
# 修改密码后需同步更新 registry/auth.htpasswd 文件
# 生成 htpasswd：htpasswd -nbB registry-user 你的新密码
# ----------------------------------------------------------------
REGISTRY_HOST=localhost:5000
REGISTRY_USERNAME=registry-user
REGISTRY_PASSWORD=替换为强密码

# ----------------------------------------------------------------
# 内置对象存储 MinIO（必须修改）
# ----------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=替换为强密码_至少8位
OBJECT_STORE_SECRET_KEY=替换为强密码_至少8位

# ----------------------------------------------------------------
# Worker Token（合并部署时留空，系统自动生成）
# 如果 webapp 和 worker 分开部署，首次启动后从日志复制并填入
# ----------------------------------------------------------------
# TRIGGER_WORKER_TOKEN=tr_wgt_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------
# 邮件服务（三选一，推荐 Resend，免费 100 封/天）
# 不配置则魔法链接只在容器日志里显示
# ----------------------------------------------------------------

# 方案 A：Resend（推荐）
# EMAIL_TRANSPORT=resend
# FROM_EMAIL=noreply@你的域名
# REPLY_TO_EMAIL=noreply@你的域名
# RESEND_API_KEY=re_xxxxxxxxxx

# 方案 B：SMTP
# EMAIL_TRANSPORT=smtp
# FROM_EMAIL=noreply@你的域名
# REPLY_TO_EMAIL=noreply@你的域名
# SMTP_HOST=smtp.你的邮件服务商.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=你的邮箱账号
# SMTP_PASSWORD=你的邮箱密码

# 方案 C：AWS SES
# EMAIL_TRANSPORT=aws-ses
# FROM_EMAIL=noreply@你的域名
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxxx

# ----------------------------------------------------------------
# 第三方 OAuth 登录（可选）
# ----------------------------------------------------------------

# GitHub OAuth
# 回调地址：https://你的域名/auth/github/callback
# AUTH_GITHUB_CLIENT_ID=你的client_id
# AUTH_GITHUB_CLIENT_SECRET=你的client_secret

# Google OAuth
# 回调地址：https://你的域名/auth/google/callback
# AUTH_GOOGLE_CLIENT_ID=你的client_id.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=你的client_secret

# ----------------------------------------------------------------
# 访问控制（可选）
# ----------------------------------------------------------------

# 限制可注册的邮箱（正则表达式）
# WHITELISTED_EMAILS=^(you@gmail\.com|team@company\.com)$

# 管理员邮箱（正则表达式，首次创建用户前设置）
# ADMIN_EMAILS=^admin@your\.domain\.com$

# ----------------------------------------------------------------
# 任务队列限制（放宽默认限速，适合单机高负载）
# ----------------------------------------------------------------
MAXIMUM_DEPLOYED_QUEUE_SIZE=500000
MAXIMUM_DEV_QUEUE_SIZE=100000
