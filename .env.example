# ================================================================
# Trigger.dev v4 环境变量配置
# 基于 triggerdotdev/trigger.dev 官方 hosting/docker 配置整合
# 部署前请修改所有标注「⚠️ 必须修改」的项目
# 生成随机密钥命令：openssl rand -hex 32
# ================================================================

# ----------------------------------------------------------------
# 版本锁定（推荐，避免自动升级出问题）
# ----------------------------------------------------------------
TRIGGER_IMAGE_TAG=v4.4.4

# ----------------------------------------------------------------
# 访问地址（⚠️ 必须修改）
# 如果有域名：https://trigger.yourdomain.com
# 如果用 IP：http://你的服务器IP:8030
# ----------------------------------------------------------------
APP_ORIGIN=https://trigger.yourdomain.com

# ----------------------------------------------------------------
# PostgreSQL（⚠️ 必须修改密码）
# ----------------------------------------------------------------
POSTGRES_USER=trigger
POSTGRES_PASSWORD=<openssl rand -hex 16>
POSTGRES_DB=trigger

# ----------------------------------------------------------------
# 安全密钥（⚠️ 必须修改，四个值均需不同，使用 openssl rand -hex 32）
# ----------------------------------------------------------------
SESSION_SECRET=<openssl rand -hex 32>
MAGIC_LINK_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
BETTER_AUTH_SECRET=<openssl rand -hex 32>

# ----------------------------------------------------------------
# Managed Worker Secret（⚠️ 必须修改）
# webapp 和 worker 必须一致
# ----------------------------------------------------------------
MANAGED_WORKER_SECRET=<openssl rand -hex 32>

# ----------------------------------------------------------------
# 内置镜像仓库（⚠️ 必须修改密码）
# 修改密码后需同步更新 registry/auth.htpasswd 文件
# 生成 htpasswd：htpasswd -Bbn <username> <password>
# REGISTRY_HOST 容器内部用 registry:5000，外部访问用 域名:5000
# ----------------------------------------------------------------
REGISTRY_HOST=registry:5000
REGISTRY_USERNAME=registry-user
REGISTRY_PASSWORD=<openssl rand -hex 16>

# ----------------------------------------------------------------
# 内置对象存储 MinIO（⚠️ 必须修改）
# ----------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=<openssl rand -hex 16>
OBJECT_STORE_SECRET_KEY=<openssl rand -hex 16>

# ----------------------------------------------------------------
# ClickHouse（可选，默认值即可）
# ----------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123

# ----------------------------------------------------------------
# Electric（可选，默认 1.2.4）
# ----------------------------------------------------------------
ELECTRIC_IMAGE_TAG=1.2.4

# ----------------------------------------------------------------
# Run Replication（可选，默认开启）
# 将 PostgreSQL run 数据复制到 ClickHouse
# ----------------------------------------------------------------
RUN_REPLICATION_ENABLED=1
RUN_REPLICATION_LOG_LEVEL=info

# ----------------------------------------------------------------
# Worker 副本数（可选，默认 2）
# 建议不超过 CPU核心数-2，16C 服务器建议 2-4
# ----------------------------------------------------------------
WORKER_REPLICAS=2

# ----------------------------------------------------------------
# Worker Token（合并部署时留空，系统自动生成）
# 如果 webapp 和 worker 分开部署，首次启动后从日志复制并填入
# ----------------------------------------------------------------
# TRIGGER_WORKER_TOKEN=tr_wgt_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------
# 邮件服务（三选一）
# 不配置则魔法链接只在容器日志里显示
# ----------------------------------------------------------------

# 方案 A：Resend（推荐，免费 100 封/天）
# EMAIL_TRANSPORT=resend
# FROM_EMAIL=noreply@yourdomain.com
# REPLY_TO_EMAIL=noreply@yourdomain.com
# RESEND_API_KEY=re_xxxxxxxxxx

# 方案 B：SMTP
# EMAIL_TRANSPORT=smtp
# FROM_EMAIL=noreply@yourdomain.com
# REPLY_TO_EMAIL=noreply@yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email
# SMTP_PASSWORD=your-password

# 方案 C：AWS SES
# EMAIL_TRANSPORT=aws-ses
# FROM_EMAIL=noreply@yourdomain.com
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxxx

# ----------------------------------------------------------------
# 第三方 OAuth 登录（可选）
# ----------------------------------------------------------------

# GitHub OAuth
# 回调地址：https://trigger.yourdomain.com/auth/github/callback
# AUTH_GITHUB_CLIENT_ID=your_client_id
# AUTH_GITHUB_CLIENT_SECRET=your_client_secret

# Google OAuth
# 回调地址：https://trigger.yourdomain.com/auth/google/callback
# AUTH_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=your_client_secret

# ----------------------------------------------------------------
# 访问控制（可选）
# ----------------------------------------------------------------

# 限制可注册的邮箱（正则表达式）
# WHITELISTED_EMAILS=^(you@gmail\.com|team@company\.com)$

# 管理员邮箱（正则表达式，首次创建用户前设置）
# ADMIN_EMAILS=^admin@your\.domain\.com$

# ----------------------------------------------------------------
# 任务队列限制（可选，默认值适合单机高负载）
# ----------------------------------------------------------------
MAXIMUM_DEPLOYED_QUEUE_SIZE=500000
MAXIMUM_DEV_QUEUE_SIZE=100000

# ----------------------------------------------------------------
# 镜像版本（可选，一般不需要修改）
# ----------------------------------------------------------------
# POSTGRES_IMAGE_TAG=16-alpine
# REDIS_IMAGE_TAG=7-alpine
# CLICKHOUSE_IMAGE_TAG=25.5-alpine

# ----------------------------------------------------------------
# 发布 IP 绑定（可选，默认 0.0.0.0）
# 限制只监听 localhost 时设为 127.0.0.1
# ----------------------------------------------------------------
# WEBAPP_PUBLISH_IP=0.0.0.0
# REGISTRY_PUBLISH_IP=127.0.0.1
# MINIO_PUBLISH_IP=0.0.0.0
